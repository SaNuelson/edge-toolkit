{
  "name": "edge-toolkit",
  "version": "0.0.0",
  "private": true,
  "description": "A monorepo for focused Microsoft Edge extensions.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "package:bgg": "npm run package --workspace @edge-toolkit/bgg-linker",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.3.0",
    "adm-zip": "^0.6.1",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vitest": "^5.1.1"
  }
}
